+            + ", ".join(missing)
+            + ". Check .env at the repository root."
+        )
+    if not PHASE2_CHUNKS_FILE.is_file():
+        raise RuntimeError(
+            f"Phase 2 chunk corpus not found: {PHASE2_CHUNKS_FILE}. "
+            "Run the Phase 2 ingestion pipeline first."
+        )
+
+
+@dataclass(frozen=True)
+class RetrievalConfig:
+    dense_top_k: int = 20
+    sparse_top_k: int = 20
