+
+DEFAULT_RETRIEVAL = RetrievalConfig()
+
+PAYLOAD_KEYWORD_FIELDS = (
+    "seller_id",
+    "department",
+    "classification",
+    "document_type",
+    "scenario_id",
+)
+
+SANITY_QUERIES = (
