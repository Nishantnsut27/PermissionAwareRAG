
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_API_URL=https://api.jina.ai/v1/embeddings


QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge


GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_KEY_COOLDOWN_S=60
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1200
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_S=60
GROQ_MAX_RETRIES=2


JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
RERANK_ENABLED=true
RERANK_TIMEOUT_S=30
RERANK_SCORE_THRESHOLD=0.20


ANSWER_TOP_K=5
ANSWER_CANDIDATE_POOL=20
MAX_HISTORY_TURNS=6
MAX_HISTORY_CHARS=1500
MAX_CONTEXT_CHARS=12000
MAX_QUERY_CHARS=1000


OPENJEV_API_KEY=
OPENJEV_BASE_URL=https://api.openjev.sh/v1/systemone
OPENJEV_MODEL=openjev
OPENJEV_TIMEOUT_S=8
OPENJEV_MAX_RETRIES=1
OPENJEV_ENABLED=true

QUERY_AWARE_ENABLED=true
QUERY_AWARE_IDENTIFIER_CANDIDATES=10
QUERY_AWARE_PROMOTION=true
QUERY_AWARE_PROMOTE_CRITERIA=aspect,date
QUERY_AWARE_MAX_PROMOTED=4

# Phase 7 query-aware reranking. RERANK_PLAN_WEIGHT bounds the TOTAL plan
# adjustment added to a Jina score; the signal weights set the relative split
# inside that bound. Defaults are the Phase 7 ablation winner: evidence-type
# only, query hints off. Set RERANK_PLAN_AWARE=false for pre-Phase-7 ordering.
RERANK_PLAN_AWARE=true
RERANK_PLAN_WEIGHT=0.06
RERANK_PLAN_ASPECT_WEIGHT=0.0
RERANK_PLAN_EVENT_WEIGHT=0.0
RERANK_PLAN_INTENT_WEIGHT=0.0
RERANK_PLAN_EVIDENCE_WEIGHT=1.0
RERANK_PLAN_SELLER_WEIGHT=0.0
RERANK_PLAN_QUERY_HINTS=false


API_HOST=127.0.0.1
API_PORT=8000


EVAL_JUDGE_MAX_TOKENS=900
EVAL_CASE_TOP_K=5
EVAL_CASE_DELAY_S=90
EVAL_RETRY_WAIT_S=90
EVAL_MAX_RETRIES=0
# Enable full cross-user reports only on a trusted local demo. Not authentication.
EVALUATION_REPORTS_ENABLED=false
