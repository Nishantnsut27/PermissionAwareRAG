
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_API_URL=https://api.jina.ai/v1/embeddings


QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge


GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_KEY_COOLDOWN_S=60
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1200
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_S=60
GROQ_MAX_RETRIES=2


JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
RERANK_ENABLED=true
RERANK_TIMEOUT_S=30
RERANK_SCORE_THRESHOLD=0.20


ANSWER_TOP_K=5
ANSWER_CANDIDATE_POOL=20
# Global hybrid baseline; opt in to bounded multi-account retrieval with seller_balanced.
MULTI_SELLER_RETRIEVAL=global
MAX_HISTORY_TURNS=6
MAX_HISTORY_CHARS=1500
MAX_CONTEXT_CHARS=12000
MAX_CONTEXT_TOKENS=12000
MAX_QUERY_CHARS=1000


# Demo selector is disabled by default. Public demo mode is only for synthetic data.
API_DEMO_MODE=false
# Defaults to API_DEMO_MODE; set false to keep a demo deployment loopback-only.
# API_PUBLIC_DEMO_MODE=false
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_CONCURRENT_REQUESTS=8
API_BODY_TIMEOUT_S=5
API_HEADER_TIMEOUT_S=5
API_REQUEST_TIMEOUT_S=90
API_REQUESTS_PER_MINUTE=30
API_TOKENS_PER_MINUTE=30000

EVAL_JUDGE_MAX_TOKENS=900
EVAL_CASE_TOP_K=5
EVAL_CASE_DELAY_S=90
EVAL_RETRY_WAIT_S=90
EVAL_MAX_RETRIES=0
# Enables the detailed report endpoint after operator authorization; never grants access.
EVALUATION_REPORTS_ENABLED=false
